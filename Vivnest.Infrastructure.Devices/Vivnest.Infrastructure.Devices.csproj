<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Device protocols and drivers - Tapo cameras and hubs, RTSP capture,
    Kasa smart plugs, Tapo motion sensors.

    Split out of Vivnest.Infrastructure on 2026-08-24 (ADR-109). Cloud
    references Infrastructure for three Azure classes; before the split
    that made an Azure Functions app compile against, and deploy,
    TapoSharp and the KLAP protocol client. Nothing here can run in Cloud.

    Namespaces are unchanged - Vivnest.Infrastructure.Camera etc. - so
    consumers saw no edit. Only the assembly boundary moved.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Vivnest.Infrastructure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="TapoSharp" Version="1.0.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vivnest.Core\Vivnest.Core.csproj" />
  </ItemGroup>

</Project>
