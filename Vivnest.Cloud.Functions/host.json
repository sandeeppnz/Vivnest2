{
  "version": "2.0",
  "extensions": {
    "queues": {
      "messageEncoding": "none"
    }
  },
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request"
      }
    },
    "logLevel": {
      "default": "Trace",
      "Host": "Trace",
      "Host.Results": "Trace",
      "Function": "Trace"
    }
  }
}