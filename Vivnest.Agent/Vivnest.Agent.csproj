<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>    <ProjectReference Include="..\Vivnest.Core\Vivnest.Core.csproj" />
    <ProjectReference Include="..\Vivnest.Capabilities\Vivnest.Capabilities.csproj" />
    <ProjectReference Include="..\Vivnest.Infrastructure\Vivnest.Infrastructure.csproj" />
    <ProjectReference Include="..\Vivnest.Infrastructure.Devices\Vivnest.Infrastructure.Devices.csproj" />
    <ProjectReference Include="..\Vivnest.Runtime\Vivnest.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <!-- SkiaSharp alone ships only managed bindings, no native library -
         on Linux (this Agent's container OS) SkiaApi's static constructor
         throws the moment any SkiaSharp API is first touched without this.
         .NoDependencies since the Dockerfile's runtime base image doesn't
         install libfontconfig1/libGL1/etc that the regular Linux native
         asset package would need. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both of these are absent from a fresh clone and that is correct.
         common-config.secrets.json is gitignored (*.secrets.json) and read
         by TryLoadLocalSharedSecrets when a developer has one;
         Tools/ffmpeg.exe is a Windows-dev convenience - the container
         installs ffmpeg via apt-get instead, see RtspCamera.cs. <None
         Update> on a missing file is a no-op, so neither breaks a build.

         Removed 2026-08-24: sample.jpg (never committed, referenced
         nowhere) and 5d6c8d6f-...json, a per-device config deleted long
         ago - decision-log.md records that agent id as one that matched
         no real AgentRegistry row. -->
    <None Update="common-config.secrets.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Wildcard, not a fixed filename: the trained model doesn't exist
         until scripts/ml/sink-cleanliness/train.py produces it (ADR-032),
         and a zero-match glob is a safe no-op rather than a build error.
         Two patterns, not one: torch's exporter externalizes weights above
         a size threshold into a sibling <name>.onnx.data file - InferenceSession
         needs both alongside each other, or it can't resolve the tensors. -->
    <None Include="Models\**\*.onnx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="Models\**\*.onnx.data">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Runtime\**" />
    <EmbeddedResource Remove="Runtime\**" />
    <None Remove="Runtime\**" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Tools\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Bootstrap/ConfigurationLoading classes are internal - they
         exist for AgentConfigurationLoader, not as an API - but their
         pure parts (secrets deep-merge, source ordering, the enc:v1:
         no-key warning) are tested. Same pairing Vivnest.Cloud and
         Vivnest.Infrastructure.Devices already declare. -->
    <InternalsVisibleTo Include="Vivnest.Tests" />
  </ItemGroup>

</Project>
