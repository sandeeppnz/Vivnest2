{
  "Agent": {
    // Uncomment exactly one AgentId line below, matching which agent
    // this Updater instance manages (decision-log.md ADR-035's
    // follow-up on running both roles on one Docker host).

    // Low-type agent
    // "AgentId": "5d6c8d6f-4b8d-47e0-a56f-3c3e8cdb2d63"

    // High-type agent
    // "AgentId": "3a56ad98-5410-4d28-9dea-21759ad6ce4e"
  },
  "Messaging": {
    "ConnectionString": "",
    "DeployCommandQueue": "agent-deploy-commands"
  },
  "Deploy": {
    "PollInterval": "00:00:30",

    // Uncomment the ContainerName line matching the AgentId chosen
    // above - both need to agree on which agent this instance is.

    // Low-type agent
    // "ContainerName": "vivnest-agent-capture"

    // High-type agent
    // "ContainerName": "vivnest-agent-ai"

    // ACR repository-scoped token (ADR-039) - lets this Updater log in to
    // the registry itself before every pull, instead of depending on a
    // prior manual `az acr login` on this host, which expires if nobody's
    // been at the machine recently. Both empty means the login step is
    // skipped and pull behaves exactly as before.
    "AcrUsername": "",
    "AcrPassword": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
