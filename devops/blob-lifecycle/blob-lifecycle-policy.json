{
  "rules": [
    {
      "enabled": true,
      "name": "delete-old-photos",
      "type": "Lifecycle",
      "definition": {
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 30
            }
          }
        },
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["photos/"]
        }
      }
    }
  ]
}
