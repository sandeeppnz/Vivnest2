<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Both net8.0, same as this project, so the runtime layer IS unit
         testable - unlike Vivnest.Agent, which targets net10.0 and cannot
         be referenced from here at all. -->    <ProjectReference Include="..\Vivnest.Runtime\Vivnest.Runtime.csproj" />
    <ProjectReference Include="..\Vivnest.Core\Vivnest.Core.csproj" />
    <ProjectReference Include="..\Vivnest.Cloud\Vivnest.Cloud.csproj" />
    <ProjectReference Include="..\Vivnest.Cloud.Functions\Vivnest.Cloud.Functions.csproj" />
  </ItemGroup>

</Project>
