<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Everything targets net8.0 as of 2026-08-24, so this project can
         reference the whole solution and there is one test project again.
         Vivnest.Agent.Tests existed only because Vivnest.Agent was net10.0
         and could not be referenced from here (NU1201); its three files
         moved back in when that difference went away. -->    <ProjectReference Include="..\Vivnest.Runtime\Vivnest.Runtime.csproj" />
    <ProjectReference Include="..\Vivnest.Core\Vivnest.Core.csproj" />
    <ProjectReference Include="..\Vivnest.Agent\Vivnest.Agent.csproj" />
    <ProjectReference Include="..\Vivnest.Capabilities\Vivnest.Capabilities.csproj" />
    <ProjectReference Include="..\Vivnest.Cloud\Vivnest.Cloud.csproj" />
    <ProjectReference Include="..\Vivnest.Infrastructure.Devices\Vivnest.Infrastructure.Devices.csproj" />
    <ProjectReference Include="..\Vivnest.Cloud.Functions\Vivnest.Cloud.Functions.csproj" />
  </ItemGroup>

</Project>
